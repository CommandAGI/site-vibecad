# The model key, server side only: `server/index.ts` is the site's server module and the browser never sees a key.
# On the deployment: commandagi sites env vibecad set OPENROUTER_API_KEY=… --secret
OPENROUTER_API_KEY=
# Optional: pin a model your account can access. Otherwise the server discovers one on the first call.
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# Opt-in sanitized timing/token reports in server logs; never logs input or keys.
# VIBECAD_LOG_INFERENCE=1
